# Copy this file to .env and fill in your key. Never commit .env.
OPENAI_API_KEY=

# These defaults can be changed without editing Python code.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_ASR_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin

# Baseline settings. Later experiments will live in separate config files.
RAG_CHUNK_WORDS=220
RAG_CHUNK_OVERLAP_WORDS=40
RAG_TOP_K=5
OPENAI_EMBEDDING_BATCH_SIZE=64

# Use dev while tuning. Change to test only for a held-out evaluation run.
RAG_EVAL_SPLIT=dev
